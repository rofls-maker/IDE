<Window x:Class="IDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RofloIDE" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#cccccc"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter x:Name="contentPresenter"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#666666"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#252526" Foreground="#cccccc">
            <MenuItem Header="Файл" FontSize="16">
                <MenuItem Header="Новый файл..." InputGestureText="Ctrl+N" Click="NewFileWithDialog_Click"/>
                <MenuItem Header="Новый пустой файл" InputGestureText="Ctrl+Shift+N" Click="NewFile_Click"/>
                <MenuItem Header="Открыть файл" InputGestureText="Ctrl+O" Click="OpenFile_Click"/>
                <MenuItem Header="Сохранить" InputGestureText="Ctrl+S" Click="SaveFile_Click"/>
                <MenuItem Header="Сохранить как..." InputGestureText="Ctrl+Shift+S" Click="SaveAsFile_Click"/>
                <MenuItem Header="Обновить проект" InputGestureText="F5" Click="RefreshProject_Click"/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Правка" FontSize="16">
                <MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Выделить все" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
            </MenuItem>
            <MenuItem Header="Терминал" FontSize="16">
                <MenuItem Header="Очистить терминал" Click="ClearTerminal_Click"/>
                <MenuItem Header="Перезапустить терминал" Click="RestartTerminal_Click"/>
                <MenuItem Header="Выполнить команду" InputGestureText="Ctrl+Enter" Click="ExecuteCommand_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="5">
                    <Button Content="📁 Открыть проект" 
            Style="{StaticResource DarkButtonStyle}"
            Click="OpenProject_Click" 
            FontSize="14"
            Margin="0,0,5,5"/>
                    <Button Content="🔄 Обновить" 
            Style="{StaticResource DarkButtonStyle}"
            Click="RefreshProject_Click" 
            FontSize="14"
            Margin="0,0,5,5"/>
                    <Button Content="📄 Новый файл..." 
            Style="{StaticResource DarkButtonStyle}"
            Click="NewFileWithDialog_Click" 
            FontSize="14"
            Margin="0,0,5,5"/>
                    <Button Content="📝 Новый пустой" 
            Style="{StaticResource DarkButtonStyle}"
            Click="NewFile_Click" 
            FontSize="14"
            Margin="0,0,5,5"/>
                    <Button Content="💾 Сохранить" 
            Style="{StaticResource DarkButtonStyle}"
            Click="SaveButton_Click" 
            FontSize="14"
            Margin="0,0,5,5"/>
                    <Button Content="▶ Скомпилировать C" 
            Style="{StaticResource DarkButtonStyle}"
            Click="CompileC_Click" 
            FontSize="14"
            Margin="0,0,0,5"/>
                </WrapPanel>

                <TreeView x:Name="FileTreeView" 
                         Grid.Row="1"
                         Background="Transparent"
                         Foreground="#cccccc"
                         BorderThickness="0"
                         Margin="5"
                         ItemContainerStyle="{StaticResource DarkTreeViewItemStyle}"
                         SelectedItemChanged="FileTreeView_SelectedItemChanged">
                </TreeView>
            </Grid>

            <Grid Grid.Column="1" x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="EditorContainer" Grid.Row="0">
                        <TextBox x:Name="MainEditor" 
                                AcceptsReturn="True"
                                AcceptsTab="True"
                                TextWrapping="NoWrap"
                                FontFamily="Consolas"
                                FontSize="14"
                                Background="#1e1e1e"
                                Foreground="#cccccc"
                                BorderThickness="0"
                                CaretBrush="#cccccc"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                TextChanged="MainEditor_TextChanged"/>
                    </ContentControl>

                    <Border Grid.Row="1" Background="#252526" Height="25">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="EditorStatus"
                                      Foreground="#888888"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Background="#333333"
                             Height="3"
                             ShowsPreview="True"/>

                <Grid Grid.Row="2" Background="#0c0c0c">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#323233">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="Терминал" 
                                      Foreground="#cccccc"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      Margin="0,0,20,0" Height="20"/>

                            <Button Content="Очистить" 
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,10,0"
                                    Click="ClearTerminal_Click" FontSize="13"/>

                            <Button Content="Перезапустить" 
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="10,4"
                                    Click="RestartTerminal_Click" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <RichTextBox x:Name="TerminalOutput"
                                Grid.Row="1"
                                IsReadOnly="True"
                                Background="#0c0c0c"
                                Foreground="#cccccc"
                                FontFamily="Consolas"
                                FontSize="14"
                                BorderThickness="0"
                                VerticalScrollBarVisibility="Auto">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>

                    <Border Grid.Row="2" Background="#1a1a1a" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="$ " 
                                      Foreground="#00ff00"
                                      FontFamily="Consolas"
                                      FontSize="12"
                                      VerticalAlignment="Center"/>

                            <TextBox x:Name="CommandInput"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    Foreground="#cccccc"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center"
                                    Margin="5,0"
                                    KeyDown="CommandInput_KeyDown"/>

                            <Button Grid.Column="2"
                                    Content="▶ Выполнить"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="10,4"
                                    Margin="5,-4,0,-4"
                                    Click="ExecuteCommand_Click"
                                    ToolTip="Выполнить команду (Ctrl+Enter)" FontSize="16"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>